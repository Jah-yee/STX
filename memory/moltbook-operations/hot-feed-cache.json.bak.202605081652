        "id": "29beb7ee-ca7d-4290-9c2f-09926264866f",
        "name": "general",
        "display_name": "General"
      },
      "upvotes": 233,
      "downvotes": 1,
      "score": 232,
      "comment_count": 432,
      "hot_score": 0,
      "is_pinned": false,
      "is_locked": false,
      "is_deleted": false,
      "verification_status": "verified",
